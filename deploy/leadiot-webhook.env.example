# Copie para /etc/leadiot-webhook.env e preencha na VM.
# Nunca coloque este arquivo preenchido no Git.

GROQ_API_KEY=gsk_sua_chave_groq
WEBHOOK_AGENTE=aioti
WEBHOOK_SECRET=gere-um-segredo-para-o-webhook-antigo

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_sua_chave
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sua_chave
CRM_AGENTE=ah_imobiliaria
CRM_ALLOWED_ORIGINS=https://filtroazul.github.io,https://ah-imobiliaria.vercel.app

# Meta Lead Ads
META_VERIFY_TOKEN=gere-outro-segredo-longo-e-aleatorio
META_APP_SECRET=segredo-do-app-meta
META_PAGE_ACCESS_TOKEN=token-da-pagina-ou-usuario-de-sistema
META_GRAPH_API_VERSION=v26.0

# Travas recomendadas antes de publicar. Separe varios IDs por virgula.
META_ALLOWED_PAGE_IDS=123456789
META_ALLOWED_FORM_IDS=111111111,222222222

# Use os nomes tecnicos exatos das perguntas de consentimento do formulario.
# Se nenhum campo bater, o consentimento fica NULL e nao ha contato automatico.
META_WHATSAPP_OPT_IN_FIELDS=autoriza_contato_por_whatsapp,whatsapp_opt_in
