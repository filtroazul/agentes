# Copie este arquivo para .streamlit/secrets.toml (local) e preencha.
# No Streamlit Community Cloud, cole o conteúdo em: App > Settings > Secrets.
# NUNCA commite o secrets.toml real — ele está no .gitignore.

GROQ_API_KEY = "gsk_sua_chave_aqui"

# --- Envio automático do lead pra equipe (opcional) ---------------------------
# Quando o assistente fecha o RESUMO DO LEAD, o app envia pros destinos abaixo.
# Sem nada configurado, ele só mostra o card na conversa (nada quebra).

# Telegram (grátis, chega no celular na hora):
# 1. No Telegram, fale com @BotFather -> /newbot -> copie o token.
# 2. Fale com o seu bot novo (manda um "oi") e depois abra
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> copie o "chat":{"id":...}
# TELEGRAM_BOT_TOKEN = "123456:ABC-token-do-botfather"
# TELEGRAM_CHAT_ID = "123456789"

# --- Bot do Telegram: atendimento do lead DENTRO do Telegram ------------------
# Roda com:  python bot_telegram.py  (usa TELEGRAM_BOT_TOKEN acima).
# O cliente conversa com o bot; o resumo do lead cai no TELEGRAM_CHAT_ID.
# TELEGRAM_AGENTE = "atendimento"   # agente do agents.yaml (aioti, corretor_imoveis...)
# TELEGRAM_NOME = "Ricardo Almeida" # nome que substitui [NOME] no prompt, se houver

# --- Webhook do ManyChat: atendimento no Instagram DM e WhatsApp --------------
# Roda com:  python webhook_manychat.py  (ou gunicorn na VM).
# O ManyChat faz POST das mensagens; o cliente conversa e o resumo cai no
# TELEGRAM_CHAT_ID / webhook, igual nos outros canais.
# WEBHOOK_AGENTE = "aioti"        # agente do agents.yaml (padrão: atendimento)
# WEBHOOK_SECRET = "uma-senha-forte-qualquer"  # exigida no header X-Webhook-Secret
# WEBHOOK_NOME = "Ricardo Almeida"             # substitui [NOME] no prompt, se houver

# --- CRM da Ah Imobiliaria ---------------------------------------------------
# O painel usa SUPABASE_ANON_KEY no navegador e continua protegido por RLS.
# O webhook precisa da SERVICE ROLE apenas para registrar mensagens que chegam
# do ManyChat, pois nesse momento nao existe uma sessao de corretor.
# SUPABASE_URL = "https://seu-projeto.supabase.co"
# SUPABASE_ANON_KEY = "sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY = "sb_secret_..."  # NUNCA colocar em js/config.js
# CRM_AGENTE = "ah_imobiliaria"
# CRM_ALLOWED_ORIGINS = "https://filtroazul.github.io,http://127.0.0.1:8720"

# --- Meta Lead Ads -> CRM ---------------------------------------------------
# Callback no painel da Meta: https://SEU-DOMINIO/meta/lead-ads
# A assinatura SHA-256 e validada antes de qualquer leitura ou gravacao.
# META_VERIFY_TOKEN = "gere-um-segredo-longo-e-aleatorio"
# META_APP_SECRET = "segredo-do-app-meta"
# META_PAGE_ACCESS_TOKEN = "token-da-pagina-ou-usuario-de-sistema"
# META_GRAPH_API_VERSION = "v26.0"
# Opcionais: restringem o webhook a IDs autorizados (separados por virgula).
# META_ALLOWED_PAGE_IDS = "123456789"
# META_ALLOWED_FORM_IDS = "111111111,222222222"
# Nomes tecnicos das perguntas que comprovam opt-in explicito no formulario.
# META_WHATSAPP_OPT_IN_FIELDS = "autoriza_contato_por_whatsapp,whatsapp_opt_in"
# Para varias paginas, use um JSON compacto no ambiente no lugar do token unico:
# META_PAGE_ACCESS_TOKENS_JSON = '{"123456789":"token-da-pagina"}'

# Webhook genérico (Google Sheets via Apps Script, Make, Zapier, CRM...):
# recebe POST JSON {"agente": "...", "momento": "...", "resumo": "..."}
# LEADS_WEBHOOK_URL = "https://exemplo.com/webhook"

# Direcionar por agente/cliente: acrescente o sufixo _<AGENTE> (maiúsculo).
# Ex.: leads do agente "aioti" pro Telegram da AIOTI, resto pro padrão:
# TELEGRAM_CHAT_ID_AIOTI = "987654321"
# LEADS_WEBHOOK_URL_CORRETOR_IMOVEIS = "https://exemplo.com/planilha-corretor"
